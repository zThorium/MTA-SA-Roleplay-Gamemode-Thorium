<meta>
    <!--
        images/map.png se genero a partir de los 144 tiles del radar (radar00-143.txd)
        de gta3.img de la instalacion local de GTA SA (ver tools/RadarExtract.cs).
        Teclas (images/keys) y sonidos .ogg: Kenney CC0 desde assets/; heartbeat.wav y coins.wav
        son propios (tools/gen_sounds.ps1). Ver CREDITOS.md.
    -->
    <info author="Thorium" name="RP HUD" description="HUD propio: minimapa, vida, necesidades, hora, dinero y velocimetro con bencina, iconos clicables (accesos rapidos y controles del vehiculo), con efectos, sonidos y tutorial de primera vez" version="1.2.0" type="script" />
    <min_mta_version client="1.6.0" />

    <include resource="rp_notify" />

    <!-- c_fx crea el estado compartido (Hud) que usan los demas: va primero -->
