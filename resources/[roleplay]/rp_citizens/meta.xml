<meta>
    <!--
        Poblacion ambiental del lado del cliente. c_nodes_ls.lua se genero desde
        data/paths/NODES*.DAT de GTA SA (red de caminos original, solo Los Santos).
        Los cambios hechos con el editor (/nodos) se guardan en path_nodes / path_links.
    -->
    <info author="Thorium" name="RP Citizens" description="Peatones y trafico con maquina de estados sobre la red de caminos de GTA SA" version="1.1.0" type="script" />
    <min_mta_version server="1.6.0" client="1.6.0" />

    <include resource="rp_database" />
    <include resource="rp_login" />
    <include resource="rp_notify" />

    <script src="s_paths.lua" type="server" />
    <script src="s_sync.lua" type="server" />
    <!-- Telemetria de conduccion (admins): telemetry/*.jsonl, ver tools/trafico -->
    <script src="s_telemetry.lua" type="server" />
    <script src="c_nodes_ls.lua" type="client" />
    <script src="c_citizens.lua" type="client" />
    <script src="c_editor.lua" type="client" />
    <!-- Pasajeros y conductor ven el mismo trafico -->
    <script src="c_sync.lua" type="client" />
    <!-- Escenas ambientales y poblacion por hora/clima (las gobierna rp_events) -->
    <script src="c_scenes.lua" type="client" />
    <!-- Vida de barrio: bandas, vecinos y grupos fijos en cada rincon -->
    <script src="c_hangouts.lua" type="client" />

    <settings>
        <!-- URL del colector opcional (tools/trafico/collector.js), p. ej. http://127.0.0.1:22100/tel ; vacio = solo archivo -->
        <setting name="collector_url" value="" />
    </settings>

    <!-- Bocina de los autos de la poblacion (sonido generado para el proyecto) -->
    <file src="sounds/horn.wav" />

    <!-- Red vial (con los cambios del editor) para otros recursos, p. ej. rp_rides -->
    <export function="getRoadGraph" type="client" />
    <export function="citizenAwayFromRoad" type="client" />

    <!-- API para rp_events: puntos de acera/calzada y peatones curiosos -->
    <export function="citizenWalkSpot" type="client" />
    <export function="citizenRoadSpot" type="client" />
    <export function="citizenWatch" type="client" />
</meta>
