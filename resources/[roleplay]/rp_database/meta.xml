<meta>
    <info author="Thorium" name="RP Database" description="Conexion MySQL compartida del gamemode roleplay" version="1.0.0" type="script" />
    <min_mta_version server="1.6.0" />

    <!-- Solo servidor: las credenciales nunca llegan al cliente -->
    <script src="config.lua" type="server" />
