# Copia este archivo como .env (cp .env.example .env) y cambia las contrasenas.
# .env esta en .gitignore: nunca lo subas.

DB_NAME=mtarp
DB_USER=mtarp
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-tambien

# Puerto de MariaDB en tu Mac (127.0.0.1). 3307 para no chocar con un MySQL local.
DB_HOST_PORT=3307

# Puertos del servidor MTA en tu Mac
MTA_PORT=22003
MTA_HTTP_PORT=22005
MTA_ASE_PORT=22126
